# Example only; do not commit .env with real values
FRAMECHESTER_ENV=development
FRAMECHESTER_TELEMETRY=false
FRAMECHESTER_PUBLISH_ENABLED=false
FRAMECHESTER_DATABASE_URL=postgresql://localhost/framechester
FRAMECHESTER_BACKUP_PROVIDER=disabled
# Set per-operator credentials in a local secret manager, not in this file or repository.

# Anthropic API (Console, nao assinatura Claude.ai). Use .env.local fora do Git.
ANTHROPIC_API_KEY=
# Defina ANTHROPIC_MODEL com um id listado por scripts/verificar_anthropic.py
# ANTHROPIC_MODEL=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# YouTube OAuth Desktop app. Caminhos locais; tokens nunca vao para o repositorio.
YOUTUBE_CLIENT_SECRET=
YOUTUBE_TOKEN_FILE=
FRAMECHESTER_HOME=

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
