{
  "name": "framechester-anuncio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Anúncio vertical Dor e solução: cenas em React renderizadas quadro a quadro no Chromium e codificadas com FFmpeg; personagens e voz clonada com modelos abertos",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "preparar": "node scripts/preparar.mjs",
    "ia:preparar": "node scripts/ia.mjs preparar",
    "personagens": "node scripts/ia.mjs personagens",
    "voz": "node scripts/ia.mjs voz",
    "transcrever": "node scripts/ia.mjs transcrever",
    "palavras:estimar": "node scripts/estimar-palavras.mjs",
    "checar": "node scripts/checar.mjs",
    "studio": "vite",
    "quadros": "node scripts/quadros.mjs",
    "render": "node scripts/render.mjs",
    "render:final": "node scripts/render.mjs --final",
    "test": "node --test tests/*.test.ts && python -m unittest discover -s tests -p \"test_*.py\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
