{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prod455/framechester/docs/schemas/storyboard.schema.json",
  "title": "Framechester semantic storyboard",
  "description": "Renderer-independent plan of an explanatory video. The authoritative validator is framechester_core::storyboard::Storyboard::validate; this document mirrors it for editors and models. Numbers shown on screen and emphasis words must be spoken in the scene narration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "channel", "format", "language", "scenes"],
  "properties": {
    "version": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "channel": { "type": "string" },
    "format": { "enum": ["vertical", "horizontal", "x"] },
    "language": { "type": "string" },
    "source_hash": { "type": "string" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/scene" }
    }
  },
  "$defs": {
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "skin", "hair", "hair_colour", "beard", "beard_colour", "outfit", "colour", "prop"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "skin": { "enum": ["light", "medium", "tan", "dark"] },
        "hair": { "enum": ["bald", "short", "long", "curly", "bun"] },
        "hair_colour": { "enum": ["black", "brown", "blonde", "red", "grey", "white"] },
        "beard": { "enum": ["none", "moustache", "goatee", "short", "long"] },
        "beard_colour": { "enum": ["black", "brown", "blonde", "red", "grey", "white"] },
        "outfit": { "enum": ["shirt", "suit", "toga", "lab_coat", "hoodie", "dress", "jersey"] },
        "colour": { "enum": ["blue", "red", "green", "yellow", "white", "black", "purple", "orange", "grey"] },
        "number": { "type": "integer", "minimum": 1, "maximum": 99 },
        "prop": { "enum": ["none", "scroll", "book", "ball", "whistle", "microphone", "laptop", "flask", "trophy"] },
        "glasses": { "type": "boolean" },
        "laurel": { "type": "boolean" }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "concept", "learning_goal", "narration", "composition"],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "concept": { "type": "string", "minLength": 1, "description": "The idea this scene explains, one short sentence; shown as the scene heading." },
        "learning_goal": { "type": "string", "minLength": 1 },
        "narration": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "segments": { "type": "array", "items": { "$ref": "#/$defs/segment" }, "description": "Filled by narration: one entry per synthesized sentence with real timing." },
        "duration_secs": { "type": "number", "minimum": 0 },
        "start_secs": { "type": "number", "minimum": 0 },
        "composition": { "$ref": "#/$defs/composition" },
        "animations": { "type": "array", "items": { "$ref": "#/$defs/animation" } },
        "captions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "emphasis": { "type": "array", "items": { "type": "string" }, "description": "Words shown in the accent colour; each must appear in the narration." },
            "hidden": { "type": "boolean" }
          }
        },
        "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "spoken_terms": { "type": "array", "items": { "type": "string" } },
            "min_visual_changes": { "type": "integer", "minimum": 0 },
            "max_still_secs": { "type": "number", "exclusiveMinimum": 0 },
            "readable_without_audio": { "type": "boolean" }
          }
        },
        "transition": { "enum": ["cut", "fade", "push", "zoom"] }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "start_secs", "end_secs"],
      "properties": {
        "text": { "type": "string" },
        "start_secs": { "type": "number" },
        "end_secs": { "type": "number" },
        "words": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "start_secs", "end_secs"],
            "properties": {
              "text": { "type": "string" },
              "start_secs": { "type": "number" },
              "end_secs": { "type": "number" }
            }
          }
        },
        "aligned": { "type": "boolean", "description": "true when word boundaries came from a forced aligner; false when interpolated." }
      }
    },
    "cue": {
      "description": "When an animation happens, in narration terms.",
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["time"], "properties": { "time": { "type": "object", "required": ["secs"], "properties": { "secs": { "type": "number", "minimum": 0 } } } } },
        { "type": "object", "additionalProperties": false, "required": ["word"], "properties": { "word": { "type": "object", "required": ["word"], "properties": { "word": { "type": "string" }, "occurrence": { "type": "integer", "minimum": 0 } } } } },
        { "type": "object", "additionalProperties": false, "required": ["segment"], "properties": { "segment": { "type": "object", "required": ["index"], "properties": { "index": { "type": "integer", "minimum": 0 } } } } },
        { "const": "start" },
        { "type": "object", "additionalProperties": false, "required": ["end"], "properties": { "end": { "type": "object", "properties": { "before_secs": { "type": "number", "minimum": 0 } } } } },
        { "type": "object", "additionalProperties": false, "required": ["fraction"], "properties": { "fraction": { "type": "object", "required": ["fraction"], "properties": { "fraction": { "type": "number", "minimum": 0, "maximum": 1 } } } } }
      ]
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "motion", "at"],
      "properties": {
        "target": { "type": "string", "description": "Object id in the composition, `*` for every object, or `line:N` for code lines." },
        "motion": { "enum": ["reveal", "draw", "pop", "highlight", "pulse", "focus", "count", "grow", "move_to", "type", "hide", "breathe"] },
        "at": { "$ref": "#/$defs/cue" },
        "duration_secs": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
        "easing": { "enum": ["linear", "ease_out", "ease_in_out", "ease_in", "back", "spring"] },
        "destination": { "type": "string" }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "pattern": "^[^\\s*]+$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 60 },
        "detail": { "type": "string", "maxLength": 120 },
        "role": { "enum": ["neutral", "primary", "secondary", "accent", "success", "warning", "danger"] },
        "icon": { "enum": ["agent", "skill", "folder", "file", "tool", "loop", "check", "cross", "bolt", "brain", "gear", "database", "cloud", "user", "clock", "chart", "shield", "search", "arrow", "question", "code", "book"] },
        "value": { "type": "number", "description": "Must be spoken in the narration." },
        "unit": { "type": "string" },
        "group": { "type": "string" },
        "parent": { "type": "string" }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "kind": { "enum": ["flow", "causes", "uses", "contains", "transforms", "compares", "loops"] },
        "label": { "type": "string" }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "license"],
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "license": { "type": "string" },
        "optional": { "type": "boolean" }
      }
    },
    "composition": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "text"], "properties": { "kind": { "const": "title" }, "text": { "type": "string", "maxLength": 140 }, "kicker": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "objects", "relations"], "properties": { "kind": { "const": "flow_diagram" }, "objects": { "type": "array", "minItems": 2, "maxItems": 24, "items": { "$ref": "#/$defs/object" } }, "relations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/relation" } }, "looped": { "type": "boolean" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "left_title", "right_title", "objects"], "properties": { "kind": { "const": "comparison" }, "left_title": { "type": "string" }, "right_title": { "type": "string" }, "objects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/object" } } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "objects"], "properties": { "kind": { "const": "timeline" }, "objects": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "$ref": "#/$defs/object" } } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "title", "objects"], "properties": { "kind": { "const": "chart" }, "title": { "type": "string" }, "objects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/object" } }, "max_value": { "type": "number", "exclusiveMinimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "objects", "relations"], "properties": { "kind": { "const": "architecture" }, "objects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/object" } }, "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "language", "lines"], "properties": { "kind": { "const": "code" }, "language": { "type": "string" }, "lines": { "type": "array", "minItems": 1, "maxItems": 18, "items": { "type": "string", "maxLength": 48 } }, "file_name": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "before", "after"], "properties": { "kind": { "const": "transformation" }, "before": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/object" } }, "after": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/object" } }, "label": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "objects"], "properties": { "kind": { "const": "annotation" }, "objects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/object" } }, "notes": { "type": "array", "items": { "$ref": "#/$defs/relation" } } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "title", "objects"], "properties": { "kind": { "const": "infographic" }, "title": { "type": "string" }, "objects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/object" } } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "objects"], "properties": { "kind": { "const": "cause_effect" }, "objects": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "$ref": "#/$defs/object" } } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "character", "pose", "text"], "properties": { "kind": { "const": "character" }, "character": { "enum": ["presenter", "developer", "scientist", "robot"] }, "pose": { "enum": ["explain", "point", "think", "celebrate"] }, "text": { "type": "string", "minLength": 1, "maxLength": 140 }, "persona": { "$ref": "#/$defs/persona" } } }
      ]
    }
  }
}
