{
  "name": "framechester",
  "version": "0.1.0",
  "description": "Open-source, self-hosted, single-operator media production engine: Rust engine and local TypeScript Studio",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prod455/framechester.git"
  },
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "voices:setup": "node scripts/voices.mjs",
    "voices:models": "node scripts/voices.mjs --models-only",
    "setup": "node scripts/infra.mjs setup",
    "start": "node scripts/infra.mjs start",
    "dev": "node scripts/infra.mjs dev",
    "stop": "node scripts/infra.mjs stop",
    "infra:test": "node --test scripts/infra.test.mjs",
    "docker:prepare": "node scripts/infra.mjs docker:prepare",
    "docker:up": "node scripts/infra.mjs docker:up",
    "docker:down": "node scripts/infra.mjs docker:down",
    "docker:logs": "node scripts/infra.mjs docker:logs",
    "docker:status": "node scripts/infra.mjs docker:status",
    "docker:doctor": "node scripts/infra.mjs docker:doctor",
    "docker:config": "node scripts/infra.mjs docker:config"
  }
}
