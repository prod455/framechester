{
  "name": "framechester-remotion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Anúncio vertical em Remotion: roteiro Dor e solução, personagens 3D e voz clonada gerados localmente com modelos abertos",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "preparar": "node scripts/preparar.mjs",
    "ia:preparar": "node scripts/ia.mjs preparar",
    "personagens": "node scripts/ia.mjs personagens",
    "voz": "node scripts/ia.mjs voz",
    "transcrever": "node scripts/ia.mjs transcrever",
    "palavras:estimar": "node scripts/estimar-palavras.mjs",
    "checar": "node scripts/checar.mjs",
    "studio": "remotion studio src/index.ts",
    "quadros": "node scripts/quadros.mjs",
    "render": "node scripts/render.mjs",
    "render:final": "node scripts/render.mjs --final",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts && python -m unittest discover -s tests -p \"test_*.py\""
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "typescript": "5.9.3"
  }
}
