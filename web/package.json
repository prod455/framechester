{
  "name": "framechester-studio",
  "version": "0.1.0",
  "description": "Local Studio (Vite frontend and loopback Node server) of the Framechester media production engine",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prod455/framechester.git",
    "directory": "web"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && npm run format:check",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "engine:build": "tsx scripts/build-engine.ts",
    "format": "prettier --write \"{src,server,shared,tests,scripts}/**/*.ts\" vite.config.ts",
    "format:check": "prettier --check \"{src,server,shared,tests,scripts}/**/*.ts\" vite.config.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.1",
    "@types/node": "^26.6.5",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "basecoat-css": "1.1.0"
  }
}
